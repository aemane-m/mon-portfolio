---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { person, social } from "../data/profile";

interface Props { title: string; description: string; image?: string; type?: "website" | "article"; }
const { title, description, image = "/images/avatar.jpg", type = "website" } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(path === "/" ? "/" : path, Astro.site).href;
const og = new URL(image, Astro.site).href;
const hasPhotos = (await getCollection("photos", (p) => !p.data.draft)).length > 0;
const nav = [{ href: "/about", label: "About" }, { href: "/work", label: "Projects" }, { href: "/blog", label: "Journal" }, ...(hasPhotos ? [{ href: "/photos", label: "Photos" }] : [])];
const ld = {
  "@context": "https://schema.org", "@type": "Person", name: person.name, jobTitle: person.role,
  url: Astro.site?.href, email: person.email, sameAs: social.filter((s) => s.href.startsWith("http")).map((s) => s.href),
  alumniOf: "Paris Dauphine University – PSL",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4efe5" />
    <script is:inline>
      try { var t = localStorage.getItem("theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label="Home"><i></i>Aemane Mouteirou</a>
        <nav aria-label="Main navigation">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
          <button class="theme" id="theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <a class="cta" href={`mailto:${person.email}`}>Get in touch</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <p class="foot-big">Let’s talk about your data.</p>
        <div>
          <a href={`mailto:${person.email}`}>{person.email}</a><br />
          {social.filter((s) => s.href.startsWith("http")).map((s, i) => <>{i > 0 && " · "}<a href={s.href} rel="noopener">{s.name}</a></>)}
        </div>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const isDark = () => root.dataset.theme === "dark" || (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
      const sync = () => {
        const btn = document.getElementById("theme-toggle");
        btn?.setAttribute("aria-pressed", String(isDark()));
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", isDark() ? "#12100d" : "#f4efe5");
        dispatchEvent(new Event("themechange"));
      };
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        sync();
      });
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { if (!root.dataset.theme) sync(); });
      sync();
    </script>
    <style is:global>
      .theme { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--text); cursor: pointer; }
      .theme:hover { border-color: var(--accent); color: var(--accent); }
      .theme .i-sun { display: none; }
      :root[data-theme="dark"] .theme .i-sun { display: block; } :root[data-theme="dark"] .theme .i-moon { display: none; }
      @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .theme .i-sun { display: block; } :root:not([data-theme="light"]) .theme .i-moon { display: none; } }
      .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(10px); }
      .top-in { display: flex; align-items: center; justify-content: space-between; height: 64px; }
      .brand { font-family: var(--serif); font-size: 1.15rem; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: .6rem; }
      .brand i { width: .7rem; height: .7rem; border-radius: 50%; background: var(--accent); }
      .top nav { display: flex; align-items: center; gap: 1.6rem; font-size: .92rem; }
      .top nav a { text-decoration: none; }
      .top nav a:hover, .top nav a[aria-current] { color: var(--accent); }
      .top nav .cta { background: var(--text); color: var(--bg); padding: .45rem 1rem; border-radius: 999px; font-weight: 600; }
      .top nav .cta:hover { background: var(--accent); color: var(--accent-ink); }
      .foot { margin-top: 9rem; background: var(--inv-bg); color: var(--inv-fg); padding: 4.5rem 0 3.5rem; }
      .foot a { color: var(--inv-fg); text-decoration-color: var(--accent); }
      .foot-in { display: flex; flex-wrap: wrap; gap: 2rem; justify-content: space-between; align-items: flex-end; }
      .foot-big { font-family: var(--serif); font-size: clamp(2.2rem, 6vw, 4.5rem); margin: 0; line-height: 1; letter-spacing: -0.03em; }
      @media (max-width: 640px) { .top nav a:not(.cta) { display: none; } }
    </style>
  </body>
</html>
