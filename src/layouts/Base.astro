---
import "../styles/global.css";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url";
import { getCollection } from "astro:content";
import { person, social } from "../data/profile";
import { langOf, mk, lp, altPath, cleanPath } from "../i18n";

interface Props { title: string; description: string; image?: string; type?: "website" | "article"; }
const { title, description, image = "/images/avatar.jpg", type = "website" } = Astro.props;

const lang = langOf(Astro.url);
const tr = mk(lang);
const other = lang === "fr" ? "en" : "fr";
const rawPath = cleanPath(Astro.url);
const path = lang === "fr" ? rawPath.replace(/^\/fr/, "") || "/" : rawPath; // chemin sans préfixe, pour repérer la page active
const canonical = new URL(rawPath === "/" ? "/" : rawPath, Astro.site).href;
const enUrl = new URL(lang === "en" ? rawPath : altPath(rawPath), Astro.site).href;
const frUrl = new URL(lang === "fr" ? rawPath : altPath(rawPath), Astro.site).href;
const switchHref = altPath(rawPath);
const og = new URL(image, Astro.site).href;
const hasPhotos = (await getCollection("photos", (p) => !p.data.draft)).length > 0;
const nav = [{ href: "/about", label: tr("About", "À propos") }, { href: "/work", label: tr("Projects", "Projets") }, { href: "/blog", label: tr("Journal", "Journal") }, ...(hasPhotos ? [{ href: "/photos", label: "Photos" }] : [])];
const ld = {
  "@context": "https://schema.org", "@type": "Person", name: person.name, jobTitle: person.role,
  url: Astro.site?.href, email: person.email, sameAs: social.filter((s) => s.href.startsWith("http")).map((s) => s.href),
  alumniOf: tr("Paris Dauphine University – PSL", "Université Paris Dauphine – PSL"),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4efe5" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />
    <script is:inline>
      try { var t = localStorage.getItem("theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "fr" ? "en_US" : "fr_FR"} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">{tr("Skip to content", "Aller au contenu")}</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href={lp(lang, "/")} aria-label={tr("Home", "Accueil")}><i></i>Aemane Mouteirou</a>
        <nav aria-label={tr("Main navigation", "Navigation principale")}>
          {nav.map((n) => <a href={lp(lang, n.href)} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
          <a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={tr("Voir ce site en français", "View this site in English")} title={tr("Français", "English")}>{lang === "fr" ? "EN" : "FR"}</a>
          <button class="theme" id="theme-toggle" type="button" aria-label={tr("Toggle dark mode", "Basculer le mode sombre")}>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <a class="cta" href={`mailto:${person.email}`}>{tr("Get in touch", "Me contacter")}</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <p class="foot-big">{tr("Let’s talk about your data.", "Parlons de vos données.")}</p>
        <div>
          <a href={`mailto:${person.email}`}>{person.email}</a><br />
          {social.filter((s) => s.href.startsWith("http")).map((s, i) => <>{i > 0 && " · "}<a href={s.href} rel="noopener">{s.name}</a></>)}
          <div class="foot-nav">{nav.map((n) => <a href={lp(lang, n.href)}>{n.label}</a>)}<a href={switchHref} hreflang={other} lang={other}>{lang === "fr" ? "English" : "Français"}</a></div>
        </div>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const isDark = () => root.dataset.theme === "dark" || (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
      const sync = () => {
        const btn = document.getElementById("theme-toggle");
        btn?.setAttribute("aria-pressed", String(isDark()));
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", isDark() ? "#12100d" : "#f4efe5");
        dispatchEvent(new Event("themechange"));
      };
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        sync();
      });
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { if (!root.dataset.theme) sync(); });
      sync();
    </script>
    <script>
      // Diagrammes Mermaid : la bibliothèque n'est chargée que sur les pages qui en contiennent.
      const pres = [...document.querySelectorAll<HTMLElement>("pre > code.language-mermaid")].map((c) => c.parentElement as HTMLElement);
      if (pres.length) {
        const figs = pres.map((pre) => {
          const fig = document.createElement("figure");
          fig.className = "mdiagram";
          fig.dataset.src = pre.textContent ?? "";
          fig.setAttribute("role", "img");
          fig.setAttribute("aria-label", document.documentElement.lang === "fr" ? "Schéma" : "Diagram");
          pre.after(fig);
          return { pre, fig };
        });
        const { default: mermaid } = await import("mermaid");
        const v = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
        let n = 0;
        const render = async () => {
          mermaid.initialize({
            startOnLoad: false, securityLevel: "strict", theme: "base", fontFamily: v("--sans"),
            flowchart: { curve: "basis", htmlLabels: true, padding: 14 },
            themeVariables: {
              background: v("--bg"), primaryColor: v("--panel"), primaryTextColor: v("--text"), primaryBorderColor: v("--dim"),
              secondaryColor: v("--panel"), tertiaryColor: v("--bg"), lineColor: v("--dim"), textColor: v("--text"),
              clusterBkg: v("--bg"), clusterBorder: v("--line"), edgeLabelBackground: v("--bg"),
              actorBkg: v("--panel"), actorBorder: v("--dim"), actorTextColor: v("--text"), actorLineColor: v("--line"),
              signalColor: v("--text"), signalTextColor: v("--text"), noteBkgColor: v("--panel"), noteTextColor: v("--text"), noteBorderColor: v("--line"),
              labelBoxBkgColor: v("--panel"), labelBoxBorderColor: v("--line"), labelTextColor: v("--text"), loopTextColor: v("--text"),
            },
          });
          for (const { fig } of figs) {
            try { const { svg } = await mermaid.render(`mmd-${n++}`, fig.dataset.src!); fig.innerHTML = svg; } catch { /* le bloc source reste visible */ }
          }
          figs.forEach(({ pre, fig }) => { if (fig.querySelector("svg")) pre.style.display = "none"; });
        };
        await render();
        addEventListener("themechange", render);
      }
    </script>
    <style is:global>
      .mdiagram { margin: 2rem 0; padding: 1.2rem; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); overflow-x: auto; display: flex; justify-content: center; }
      .mdiagram svg { max-width: 100%; height: auto; }
      .lang { font-family: var(--mono); font-size: .78rem; font-weight: 600; letter-spacing: .06em; padding: .3rem .55rem; border: 1px solid var(--line); border-radius: 999px; color: var(--text); text-decoration: none; }
      .lang:hover { border-color: var(--accent); color: var(--accent); }
      .theme { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--text); cursor: pointer; }
      .theme:hover { border-color: var(--accent); color: var(--accent); }
      .theme .i-sun { display: none; }
      :root[data-theme="dark"] .theme .i-sun { display: block; } :root[data-theme="dark"] .theme .i-moon { display: none; }
      @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .theme .i-sun { display: block; } :root:not([data-theme="light"]) .theme .i-moon { display: none; } }
      .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(10px); }
      .top-in { display: flex; align-items: center; justify-content: space-between; height: 64px; }
      .brand { font-family: var(--serif); font-size: 1.15rem; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: .6rem; }
      .brand i { width: .7rem; height: .7rem; border-radius: 50%; background: var(--accent); }
      .top nav { display: flex; align-items: center; gap: 1.6rem; font-size: .92rem; }
      .top nav a { text-decoration: none; }
      .top nav a:hover, .top nav a[aria-current] { color: var(--accent); }
      .top nav .cta { background: var(--text); color: var(--bg); padding: .45rem 1rem; border-radius: 999px; font-weight: 600; }
      .top nav .cta:hover { background: var(--accent); color: var(--accent-ink); }
      .foot { margin-top: 9rem; background: var(--inv-bg); color: var(--inv-fg); padding: 4.5rem 0 3.5rem; }
      .foot a { color: var(--inv-fg); text-decoration-color: var(--accent); }
      .foot-in { display: flex; flex-wrap: wrap; gap: 2rem; justify-content: space-between; align-items: flex-end; }
      .foot-big { font-family: var(--serif); font-size: clamp(2.2rem, 6vw, 4.5rem); margin: 0; line-height: 1; letter-spacing: -0.03em; }
      .foot-nav { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; margin-top: 1rem; font-size: .9rem; }
      @media (max-width: 720px) {
        .top-in { flex-wrap: wrap; height: auto; padding-top: .6rem; padding-bottom: .5rem; row-gap: .4rem; }
        .top nav { display: contents; }
        .top nav a:not(.cta) { order: 5; font-size: .92rem; padding: .35rem .2rem; }
        .top-in::after { content: ""; order: 4; flex-basis: 100%; height: 0; }
        .brand { margin-right: auto; }
        .top nav .cta { padding: .35rem .8rem; font-size: .85rem; }
      }
    </style>
  </body>
</html>
