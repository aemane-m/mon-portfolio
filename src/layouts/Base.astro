---
import "../styles/global.css";
import { person, social } from "../data/profile";

interface Props { title: string; description: string; image?: string; type?: "website" | "article"; }
const { title, description, image = "/images/avatar.jpg", type = "website" } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(path === "/" ? "/" : path, Astro.site).href;
const og = new URL(image, Astro.site).href;
const nav = [{ href: "/about", label: "About" }, { href: "/work", label: "Projects" }, { href: "/blog", label: "Writing" }];
const ld = {
  "@context": "https://schema.org", "@type": "Person", name: person.name, jobTitle: person.role,
  url: Astro.site?.href, email: person.email, sameAs: social.filter((s) => s.href.startsWith("http")).map((s) => s.href),
  alumniOf: "Paris Dauphine University – PSL",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4efe5" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label="Home"><i></i>Aemane Mouteirou</a>
        <nav aria-label="Main navigation">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
          <a class="cta" href={`mailto:${person.email}`}>Get in touch</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <p class="foot-big">Let’s talk about your data.</p>
        <div>
          <a href={`mailto:${person.email}`}>{person.email}</a><br />
          {social.filter((s) => s.href.startsWith("http")).map((s, i) => <>{i > 0 && " · "}<a href={s.href} rel="noopener">{s.name}</a></>)}
        </div>
      </div>
    </footer>
    <style is:global>
      .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(10px); }
      .top-in { display: flex; align-items: center; justify-content: space-between; height: 64px; }
      .brand { font-family: var(--serif); font-size: 1.15rem; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: .6rem; }
      .brand i { width: .7rem; height: .7rem; border-radius: 50%; background: var(--accent); }
      .top nav { display: flex; align-items: center; gap: 1.6rem; font-size: .92rem; }
      .top nav a { text-decoration: none; }
      .top nav a:hover, .top nav a[aria-current] { color: var(--accent); }
      .top nav .cta { background: var(--text); color: var(--bg); padding: .45rem 1rem; border-radius: 999px; font-weight: 600; }
      .top nav .cta:hover { background: var(--accent); color: var(--accent-ink); }
      .foot { margin-top: 9rem; background: var(--text); color: var(--bg); padding: 4.5rem 0 3.5rem; }
      .foot a { color: var(--bg); text-decoration-color: var(--accent); }
      .foot-in { display: flex; flex-wrap: wrap; gap: 2rem; justify-content: space-between; align-items: flex-end; }
      .foot-big { font-family: var(--serif); font-size: clamp(2.2rem, 6vw, 4.5rem); margin: 0; line-height: 1; letter-spacing: -0.03em; }
      @media (max-width: 640px) { .top nav a:not(.cta) { display: none; } }
    </style>
  </body>
</html>
