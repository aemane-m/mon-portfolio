---
import { layoutPoints, type LayoutName } from "../scripts/dots";
interface Props { layout: string; size?: number }
const { layout, size = 112 } = Astro.props;
const L = layoutPoints(layout as LayoutName);
const pad = 10, S = size - pad * 2;
const X = (v: number) => Math.round(pad + v * S), Y = (v: number) => Math.round(pad + v * S);
const unit = Math.max(1.1, size / 78);
const idx = L.x.map((_, i) => i).filter((i) => L.a[i] > 0.3 && L.x[i] > -0.02 && L.x[i] < 1.02);
const links = (L.links ?? []).filter(([a, b]) => L.a[a] > 0.3 && L.a[b] > 0.3);
// Points de même couleur et même taille regroupés : un trait de longueur nulle à bout rond dessine un disque.
const groups = new Map<string, string>();
for (const i of idx) {
  const key = `${L.acc[i] > 0.5 ? "a" : "i"}|${(unit * L.r[i] * 2).toFixed(1)}`;
  groups.set(key, (groups.get(key) ?? "") + `M${X(L.x[i])} ${Y(L.y[i])}h0`);
}
---
<svg class="thumb" viewBox={`0 0 ${size} ${size}`} width={size} height={size} aria-hidden="true" focusable="false">
  {links.length > 0 && <path class="th-l" d={links.map(([a, b]) => `M${X(L.x[a])} ${Y(L.y[a])}L${X(L.x[b])} ${Y(L.y[b])}`).join("")} />}
  {[...groups].map(([key, d]) => { const [c, w] = key.split("|"); return <path class={c === "a" ? "th-a" : "th-i"} d={d} stroke-width={w} stroke-linecap="round" fill="none" />; })}
</svg>
<style is:global>
  .thumb { display: block; }
  .th-i { stroke: var(--text); } .th-a { stroke: var(--accent); }
  .th-l { stroke: var(--text); stroke-opacity: .35; stroke-width: .7; fill: none; }
</style>
