---
const { data } = Astro.props;
---
<div class="tw">
  <table>
    <thead><tr>{data.headers.map((h: { content: string }) => <th>{h.content}</th>)}</tr></thead>
    <tbody>{data.rows.map((r: string[]) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
  </table>
</div>
<style>
  .tw { overflow-x:auto; margin:1.5rem 0; border:1px solid var(--line); }
  table { border-collapse:collapse; width:100%; font-size:.9rem; }
  th, td { text-align:left; padding:.55rem .8rem; border-bottom:1px solid var(--line); vertical-align:top; }
  th { font-family:var(--mono); font-weight:500; font-size:.78rem; text-transform:uppercase; letter-spacing:.06em; color:var(--accent-text); background:var(--panel); white-space:nowrap; }
  tr:last-child td { border-bottom:0; }
  td:first-child { color:var(--text); font-weight:600; }
</style>
