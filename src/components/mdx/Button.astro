---
const { label, href, target, rel } = Astro.props;
---
<a class="btn" href={href} target={target} rel={rel}>$ open <span>{label}</span> →</a>
<style>
  .btn { display:inline-block; margin:1rem 0; padding:.55rem .9rem; border:1px solid var(--accent); color:var(--accent); font-family:var(--mono); font-size:.88rem; text-decoration:none; }
  .btn:hover { background:var(--accent); color:var(--bg); }
</style>
