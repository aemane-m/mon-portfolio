---
const { label, href, target, rel } = Astro.props;
---
<a class="btn" href={href} target={target} rel={rel}>{label} →</a>
<style>
  .btn { display:inline-block; margin:1rem 0; padding:.55rem .9rem; border-radius:999px; background:var(--accent); color:var(--accent-ink); font-weight:600; font-size:.92rem; text-decoration:none; }
  .btn:hover { background:var(--text); color:var(--bg); }
</style>
