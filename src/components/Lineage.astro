---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);

// Nœuds technos, ordonnés par barycentre pour limiter les croisements d'arêtes.
const usage = new Map<string, number[]>();
projects.forEach((p, i) => p.data.stack.forEach((t) => usage.set(t, [...(usage.get(t) ?? []), i])));
const techs = [...usage.entries()]
  .map(([name, idx]) => ({ name, idx, bary: idx.reduce((a, b) => a + b, 0) / idx.length }))
  .sort((a, b) => a.bary - b.bary || b.idx.length - a.idx.length || a.name.localeCompare(b.name));

const W = 960, PX = 12, PW = 236, TX = 748, TP = 24;
const H = Math.max(techs.length * TP + 16, projects.length * 64);
const py = (i: number) => (H / projects.length) * (i + 0.5);
const ty = (j: number) => 12 + j * TP + TP / 2 - 2;
const tIndex = new Map(techs.map((t, j) => [t.name, j]));
const edges = projects.flatMap((p, i) =>
  p.data.stack.map((t) => ({ from: p.id, to: t, d: `M ${PX + PW},${py(i)} C 500,${py(i)} 480,${ty(tIndex.get(t)!)} ${TX - 8},${ty(tIndex.get(t)!)}` })),
);
---
<figure class="lin" data-lineage>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Graphe de lineage : quels projets utilisent quelles technologies">
    <g class="edges">
      {edges.map((e) => <path class="edge" d={e.d} data-from={e.from} data-to={e.to} />)}
    </g>
    {projects.map((p, i) => (
      <a href={`/work/${p.id}`} class="node proj" data-id={p.id} data-links={p.data.stack.join("|")}>
        <rect x={PX} y={py(i) - 18} width={PW} height="36" />
        <circle cx={PX + 16} cy={py(i)} r="4.5" class={p.data.status === "in_progress" ? "live" : "ok"} />
        <text x={PX + 30} y={py(i) + 4.5}>{p.data.name ?? p.id}</text>
      </a>
    ))}
    {techs.map((t, j) => (
      <g class="node tech" data-id={t.name} data-links={t.idx.map((i) => projects[i].id).join("|")} tabindex="0">
        <rect x={TX - 8} y={ty(j) - 10} width="212" height="20" fill="transparent" />
        <circle cx={TX} cy={ty(j)} r="3" />
        <text x={TX + 12} y={ty(j) + 4}>{t.name}</text>
      </g>
    ))}
  </svg>
  <figcaption class="mono dim">↳ survole ou focus un nœud pour tracer son lineage · <span class="dot"></span>terminé <span class="dot live"></span>en cours</figcaption>
</figure>

<script>
  const root = document.querySelector<HTMLElement>("[data-lineage]");
  if (root) {
    const nodes = [...root.querySelectorAll<SVGElement>(".node")];
    const edges = [...root.querySelectorAll<SVGElement>(".edge")];
    const clear = () => { root.classList.remove("hl"); [...nodes, ...edges].forEach((n) => n.classList.remove("on")); };
    const light = (n: SVGElement) => {
      clear(); root.classList.add("hl");
      const links = (n.dataset.links ?? "").split("|");
      n.classList.add("on");
      nodes.forEach((o) => { if (links.includes(o.dataset.id!)) o.classList.add("on"); });
      edges.forEach((e) => { if (e.dataset.from === n.dataset.id || e.dataset.to === n.dataset.id) e.classList.add("on"); });
    };
    nodes.forEach((n) => {
      n.addEventListener("mouseenter", () => light(n));
      n.addEventListener("focus", () => light(n));
      n.addEventListener("mouseleave", clear);
      n.addEventListener("blur", clear);
    });
  }
</script>

<style is:global>
  .lin { margin: 0; }
  .lin svg { width: 100%; height: auto; display: block; font-family: var(--mono); font-size: 12.5px; }
  .lin .edge { fill: none; stroke: var(--line); stroke-width: 1.2; transition: opacity .15s, stroke .15s; }
  .lin .node { cursor: pointer; transition: opacity .15s; outline: none; }
  .lin .proj rect { fill: var(--panel); stroke: var(--line); }
  .lin .proj text, .lin .tech text { fill: var(--text); }
  .lin .tech text { fill: var(--dim); }
  .lin .tech circle { fill: var(--dim); }
  .lin circle.ok { fill: var(--ok); } .lin circle.live { fill: var(--accent); }
  .lin .hl .edge, .lin.hl .edge { opacity: .08; }
  .lin.hl .node { opacity: .28; }
  .lin.hl .edge.on { opacity: 1; stroke: var(--accent); stroke-width: 1.8; }
  .lin.hl .node.on { opacity: 1; }
  .lin.hl .proj.on rect { stroke: var(--accent); }
  .lin.hl .tech.on text { fill: var(--accent); } .lin.hl .tech.on circle { fill: var(--accent); }
  .lin .tech:focus-visible text { fill: var(--accent); }
  .lin figcaption { margin-top: .75rem; font-size: .76rem; }
  @media (max-width: 720px) { .lin { display: none; } }
</style>
