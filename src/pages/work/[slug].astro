---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { mdxComponents } from "../../components/mdx";

export async function getStaticPaths() {
  const all = await getCollection("projects", (p) => !p.data.draft);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const [cover, ...rest] = d.images;
const isRepo = d.link?.startsWith("http");
const kind = { personal: "Personal project", academic: "Academic project", internship: "Internship" }[d.kind];
const when = d.status === "in_progress" ? `Since ${d.publishedAt.toLocaleDateString("en-US", { month: "long", year: "numeric" })}` : d.publishedAt.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---
<Base title={`${d.title} — Aemane Mouteirou`} description={d.summary} image={cover} type="article">
  <article class="wrap page">
    <p class="eyebrow"><a href="/work" style="text-decoration:none">← Projects</a></p>
    <h1 class="big" style="font-size:clamp(2rem,4.6vw,3.8rem)">{d.title}</h1>

    {d.impact && <p class="lead2">{d.impact}</p>}

    <dl class="facts">
      <div><dt>Status</dt><dd><span class="badge" class:list={[d.status === "in_progress" && "live"]}><i></i>{d.status === "in_progress" ? "In progress" : "Completed"}</span></dd></div>
      <div><dt>Type</dt><dd>{kind}</dd></div>
      <div><dt>Period</dt><dd>{when}</dd></div>
      {d.team && <div><dt>Team</dt><dd>{d.team.map((m) => m.name).join(", ")}</dd></div>}
      {d.link && <div><dt>{isRepo ? "Code" : "Report"}</dt><dd><a href={d.link} target={isRepo ? "_blank" : undefined} rel="noopener">{isRepo ? "View on GitHub" : "Read the PDF"}</a></dd></div>}
    </dl>
    <p class="tags" style="display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 2.5rem">{d.stack.map((t) => <span class="chip">{t}</span>)}</p>

    {cover && <img class="cover" src={cover} alt={`Preview of ${d.title}`} width="1600" height="900" fetchpriority="high" decoding="async" />}

    <div class="prose"><Content components={mdxComponents} /></div>

    {rest.length > 0 && (
      <section class="gal">
        <p class="eyebrow"><b>Gallery</b></p>
        <div class="gal-grid">{rest.map((src) => <img src={src} alt={`Screenshot of ${d.title}`} loading="lazy" decoding="async" width="800" height="450" />)}</div>
      </section>
    )}
  </article>
</Base>

<style is:global>
  .lead2 { font-family: var(--serif); font-size: clamp(1.25rem, 2.2vw, 1.7rem); line-height: 1.35; max-width: 34em; margin: 0 0 2.2rem; color: var(--text); }
  .facts { display: flex; flex-wrap: wrap; gap: 1.2rem 3rem; margin: 0 0 1.6rem; padding: 1.2rem 0; border-top: 1px solid var(--text); border-bottom: 1px solid var(--line); }
  .facts dt { font-family: var(--mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: var(--dim); }
  .facts dd { margin: .2rem 0 0; font-weight: 500; }
  .cover { width: 100%; height: auto; max-height: 560px; aspect-ratio: 16/9; object-fit: cover; border-radius: 8px; margin: 0 0 3rem; background: var(--panel); display: block; }
  .gal { margin-top: 4rem; }
  .gal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; margin-top: 1rem; }
  .gal-grid img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; border-radius: 6px; }
</style>
