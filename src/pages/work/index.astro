---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
const rooms = [
  { key: "data", title: "Data", blurb: "Pipelines, platforms and the questions behind them." },
  { key: "infra", title: "Infrastructure", blurb: "A home datacentre, run the way a team would run production." },
  { key: "darkroom", title: "Darkroom", blurb: "Film, machines and the software that connects them." },
  { key: "foundations", title: "Foundations", blurb: "University projects where I learnt the craft." },
] as const;
const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
---
<Base title="Projects — Aemane Mouteirou" description="Data projects by Aemane Mouteirou: AI processing of thousands of tickets, MLOps orchestration, optimisation, data management — explained simply.">
  <div class="wrap page">
    <p class="eyebrow"><b>Projects</b></p>
    <h1 class="big">What I’ve built, <em>explained simply.</em></h1>
    {rooms.map((room) => {
      const items = projects.filter((p) => p.data.room === room.key);
      return items.length > 0 && (
        <section class="room2">
          <h2 class="room2-h"><span>{room.title}</span><small>{room.blurb}</small></h2>
          <div class="cards">
            {items.map((p) => (
              <a class="card" href={`/work/${p.id}`}>
                {p.data.images[0] && <img src={p.data.images[0]} alt="" loading="lazy" decoding="async" width="800" height="450" />}
                <span class="badge" class:list={[p.data.status === "in_progress" && "live"]}><i></i>{p.data.status === "in_progress" ? "In progress" : "Completed"}</span>
                <h3>{p.data.title.split(/ [—:] /)[0]}</h3>
                <p class="pi">{p.data.impact ?? p.data.summary}</p>
                <span class="tags">{p.data.stack.slice(0, 5).map((t) => <span class="chip">{t}</span>)}</span>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</Base>
<style is:global>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 2.4rem 2rem; }
  .card { display: grid; gap: .7rem; align-content: start; text-decoration: none; }
  .card img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 6px; background: var(--panel); transition: transform .3s, filter .3s; filter: grayscale(.85) contrast(1.05); }
  .card:hover img { filter: none; transform: translateY(-4px); }
  .card h3 { font-size: 2rem; margin: .2rem 0 0; } .card:hover h3 { color: var(--accent); }
  .room2 { margin-top: 3.5rem; }
  .room2-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem 1rem; font-family: var(--mono); font-size: .85rem; text-transform: uppercase; letter-spacing: .08em; margin: 0 0 1.4rem; color: var(--accent); padding-bottom: .6rem; border-bottom: 1px solid var(--text); }
  .room2-h small { font-family: var(--sans); text-transform: none; letter-spacing: 0; font-weight: 400; color: var(--dim); font-size: .92rem; }
  .card .pi { margin: 0; color: var(--dim); font-size: .96rem; }
  .card .badge { justify-self: start; } .card .tags { display: flex; flex-wrap: wrap; gap: .35rem; }
</style>
