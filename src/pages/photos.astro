---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
const photos = (await getCollection("photos", (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Photos — analogue film" description="Analogue photographs by Aemane Mouteirou: film stock, camera, development and scanning notes.">
  <div class="wrap page">
    <p class="eyebrow"><b>Photos</b></p>
    <h1 class="big">Developed and scanned <em>by hand.</em></h1>
    <div class="ph-grid">
      {photos.map((p) => (
        <figure class="ph">
          <a href={p.data.image} target="_blank" rel="noopener"><img src={p.data.image} alt={p.data.title} loading="lazy" decoding="async" /></a>
          <figcaption>
            <b>{p.data.title}</b>
            <span class="mono dim">{[p.data.film, p.data.camera, p.data.developer && `dev: ${p.data.developer}`, p.data.scan && `scan: ${p.data.scan}`].filter(Boolean).join(" · ")}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</Base>
<style is:global>
  .ph-grid { columns: 3 300px; column-gap: 1.2rem; }
  .ph { margin: 0 0 1.4rem; break-inside: avoid; }
  .ph img { width: 100%; height: auto; display: block; border-radius: 4px; background: var(--panel); }
  .ph figcaption { display: grid; gap: .1rem; padding-top: .5rem; font-size: .92rem; }
  .ph figcaption span { font-size: .72rem; }
</style>
