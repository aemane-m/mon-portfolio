---
import Post from "../../views/Post.astro";
import { postsFor } from "../../lib/content";
export async function getStaticPaths() {
  return (await postsFor("en")).map(({ entry, fallback }) => ({ params: { slug: entry.id }, props: { entry, fallback } }));
}
const { entry, fallback } = Astro.props;
---
<Post lang="en" entry={entry} fallback={fallback} />
