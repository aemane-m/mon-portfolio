---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("posts", (p) => !p.data.draft)).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
---
<Base title="Writing — data and production" description="Aemane Mouteirou’s write-ups on data, automation and shipping to production.">
  <div class="wrap page">
    <p class="eyebrow"><b>Writing</b></p>
    <h1 class="big">Lessons learned, <em>without needless jargon.</em></h1>
    <ul class="posts">
      {posts.map((p) => (
        <li><a href={`/blog/${p.id}`}>
          <span class="mono dim">{p.data.publishedAt.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</span>
          <h2>{p.data.title}</h2>
          <p class="dim">{p.data.summary}</p>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
<style is:global>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--text); }
  .posts a { display: grid; gap: .4rem; padding: 2rem 0; border-bottom: 1px solid var(--line); text-decoration: none; max-width: 780px; }
  .posts h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin: 0; } .posts a:hover h2 { color: var(--accent); } .posts p { margin: 0; }
</style>
