---
import Base from "../layouts/Base.astro";
import { person, experience, education, pipeline, business } from "../data/profile";
---
<Base title="About — Aemane Mouteirou" description="Aemane Mouteirou’s background: MSc 2 MIAGE at Paris Dauphine – PSL, data/AI internship at CIP PSL, skills from data collection to production.">
  <div class="wrap page">
    <p class="eyebrow"><b>About</b></p>
    <h1 class="big">Comfortable with technical teams <em>and business teams alike.</em></h1>
    <div class="two">
      <div class="prose">
        <p>I’m an <strong>MSc 2 MIAGE</strong> student at Paris Dauphine – PSL University, doing my Master’s in work-study as a data engineer at Allianz. I’m interested in everything that helps people <strong>decide better with data</strong>: collecting it cleanly, moving it reliably and making it readable for those who need it.</p>
        <p>My studies blend computer science, databases, statistics and information systems. I’m looking for a <strong>permanent data engineering role (CDI) from 2027</strong>, and I’m open to <strong>every industry</strong>.</p>
        <p>Outside work I run a <a href="/work/homelab">homelab</a> to keep my own data (photos, home automation, backups) on hardware I own, and I build the hardware and software of a <a href="/work/cinerestore">film-developing and scanning setup</a>. Those projects are where I practise production habits on my own time.</p>
      </div>
      <img class="portrait" src={person.avatar} alt={`Portrait of ${person.name}`} width="320" height="320" />
    </div>

    <section class="sec">
      <p class="eyebrow"><b>Working with business teams</b></p>
      <div class="roles">
        {business.map((b, i) => <div><span class="mono n">0{i + 1}</span><h3>{b.title}</h3><p>{b.text}</p></div>)}
      </div>
    </section>

    <section class="sec">
      <p class="eyebrow"><b>Experience</b></p>
      <ol class="tl">
        {experience.map((e) => (
          <li>
            <div class="when mono">{e.period}</div>
            <div>
              <h3>{e.role}</h3>
              <p class="who">{e.company}</p>
              <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec" id="stack">
      <p class="eyebrow"><b>Skills</b> · from raw data to decision</p>
      <div class="skills">
        {pipeline.map((s) => (
          <div>
            <h3>{s.plain}</h3>
            <p class="dim">{s.sql}</p>
            <p class="tags">{s.items.map((i) => <span class={`chip ${i.level === "pratique" ? "strong" : ""}`}>{i.name}{i.level === "apprentissage" ? " · learning" : ""}</span>)}</p>
          </div>
        ))}
      </div>
      <p class="dim small">Tools marked “learning” are ones I use in my ongoing projects, without presenting them as mastered in production.</p>
    </section>

    <section class="sec">
      <p class="eyebrow"><b>Education</b></p>
      <ol class="tl">
        {education.map((e) => (
          <li>
            <div class="when mono">{e.period}</div>
            <div><h3>{e.title}</h3><p class="who">{e.where}</p><p class="dim">{e.focus}</p></div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<style is:global>
  .page { padding-top: 4rem; }
  .big { font-size: clamp(2.4rem, 5.6vw, 4.6rem); max-width: 16em; margin: 1rem 0 3rem; letter-spacing: -0.035em; text-wrap: balance; }
  .big em { color: var(--accent); font-style: italic; }
  .two { display: grid; grid-template-columns: 1fr 260px; gap: 3rem; align-items: start; }
  .portrait { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 50%; filter: grayscale(1) contrast(1.05); border: 3px solid var(--accent); }
  .tl { list-style: none; margin: 1.5rem 0 0; padding: 0; border-top: 1px solid var(--text); }
  .tl > li { display: grid; grid-template-columns: 11rem 1fr; gap: 1.5rem; padding: 1.6rem 0; border-bottom: 1px solid var(--line); }
  .tl .when { font-size: .78rem; color: var(--dim); padding-top: .4rem; }
  .tl h3 { font-size: 1.5rem; margin: 0; }
  .tl .who { margin: .15rem 0 .7rem; color: var(--accent); font-weight: 600; font-size: .92rem; }
  .tl ul { margin: 0; padding-left: 1.1rem; max-width: 46em; } .tl ul li { margin: .3rem 0; } .tl ul li::marker { color: var(--accent); }
  .tl p { margin: 0; }
  .skills { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.2rem 2.5rem; margin-top: 1.5rem; }
  .skills h3 { font-size: 1.6rem; margin: 0; } .skills p { margin: .2rem 0 .7rem; font-size: .92rem; }
  .skills .tags { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chip.strong { background: var(--text); color: var(--bg); border-color: var(--text); }
  .small { font-size: .85rem; margin-top: 2rem; }
  @media (max-width: 760px) { .two { grid-template-columns: 1fr; } .portrait { max-width: 200px; } .tl > li { grid-template-columns: 1fr; gap: .2rem; } }
</style>
