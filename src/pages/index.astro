---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { person } from "../data/profile";
import { shapes as shape } from "../data/shapes";

const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
const posts = await getCollection("posts", (p) => !p.data.draft);
const photos = await getCollection("photos", (p) => !p.data.draft);

type Item = { kind: "project" | "note" | "article" | "photo"; title: string; date: Date; href: string; text?: string; image?: string; live?: boolean };
const items: Item[] = [
  ...projects.map((p) => ({ kind: "project" as const, title: p.data.title.split(/ [—:] /)[0], date: p.data.publishedAt, href: `/work/${p.id}`, text: p.data.impact ?? p.data.summary, live: p.data.status === "in_progress" })),
  ...posts.map((p) => ({ kind: p.data.type, title: p.data.title, date: p.data.publishedAt, href: `/blog/${p.id}`, text: p.data.summary })),
  ...photos.map((p) => ({ kind: "photo" as const, title: p.data.title, date: p.data.date, href: "/photos", image: p.data.image })),
].sort((a, b) => +b.date - +a.date);
const latest = items.slice(0, 6);

// Activité : un point par chose publiée, sur les 24 derniers mois.
const now = new Date(), MONTHS = 24;
const months = Array.from({ length: MONTHS }, (_, i) => { const d = new Date(now.getFullYear(), now.getMonth() - (MONTHS - 1 - i), 1); return { key: d.getFullYear() * 12 + d.getMonth(), label: d.toLocaleDateString("en-US", { month: "short" }), year: d.getFullYear(), n: [] as Item[] }; });
items.forEach((it) => { const k = it.date.getFullYear() * 12 + it.date.getMonth(); months.find((m) => m.key === k)?.n.push(it); });
const rowsMax = Math.max(3, ...months.map((m) => m.n.length));
const CW = 30, RH = 20, AW = MONTHS * CW + 10, AH = rowsMax * RH + 44;
const kindLabel = { project: "Project", note: "Note", article: "Article", photo: "Photo" } as const;
const rooms = [
  { key: "data", title: "Data", blurb: "Pipelines, platforms and the questions behind them." },
  { key: "infra", title: "Infrastructure", blurb: "A home datacentre, run the way a team would run production." },
  { key: "darkroom", title: "Darkroom", blurb: "Film, machines and the software that connects them." },
  { key: "foundations", title: "Foundations", blurb: "University projects where I learnt the craft." },
] as const;
const strengths = [
  { t: "Reliable pipelines", d: "Collecting, cleaning and moving data so it arrives complete, on time and protected — from 9,000 anonymised support tickets to a SAS-to-PySpark datamart migration." },
  { t: "From prototype to production", d: "I self-host my own data and learn infrastructure as code the hard way, on hardware I own." },
  { t: "A bridge to the business", d: "I start from the question the team is asking, and explain the result in plain language." },
];
---
<Base title={`${person.name} — from data to decisions`} description="Aemane Mouteirou, MSc 2 MIAGE student at Paris Dauphine – PSL: data pipelines, a Kubernetes homelab and film-scanning machines. Projects explained simply.">
  <section class="story wrap" id="story">
    <div class="stage" aria-hidden="true">
      <canvas id="story-canvas"></canvas>
      <p class="mono legend">illustrative shapes · each world has its own</p>
    </div>

    <div class="steps">
      <article class="step" data-target="0">
        <p class="eyebrow"><b>MSc 2 MIAGE</b> · Dauphine – PSL · work-study at Allianz</p>
        <h1>Data, infrastructure and film — <em>built by hand.</em></h1>
        <p class="lead">I like building things end to end, from data platforms to the machines that develop film. I work on data migration at Allianz, host my own data at home and design my own film scanners. The instinct is the same everywhere: take something raw, build a reliable process, make the result useful.</p>
        <p class="actions"><a class="btn solid" href="#projets">See the projects</a><a class="btn" href="/about">My background</a></p>
        <p class="hint mono">↓ scroll — three worlds, one way of working</p>
      </article>

      <article class="step" data-target="1">
        <p class="eyebrow"><b>01</b> · Data</p>
        <h2>From thousands of messages to the questions that matter.</h2>
        <p>At Dauphine – PSL’s Centre for Educational Innovation I turned about 9,000 Moodle support tickets into 1,900 recurring questions — anonymised, classified by local language models, ready to feed a chatbot.</p>
        <p>Since May 2026, in work-study at Allianz, I migrate a datamart from SAS to PySpark on Databricks and build a tool that exports data from SAS and Azure straight into it. On my own time, I designed QuantLab so the same business logic runs on Databricks or on infrastructure I host myself.</p>
        <p class="tags"><span class="chip">PySpark</span><span class="chip">Databricks</span><span class="chip">SAS</span><span class="chip">Azure</span><span class="chip">Python</span></p>
        <p class="actions"><a class="btn" href="/work/sas-to-pyspark">The migration →</a><a class="btn" href="/work/quantlab">QuantLab →</a></p>
      </article>

      <article class="step" data-target="2">
        <p class="eyebrow"><b>02</b> · Infrastructure</p>
        <h2>A homelab for the sovereignty of my data.</h2>
        <p>My photos live in Immich, my house runs on Home Assistant, and everything is backed up to a TrueNAS machine I own. I’m learning Terraform to provision the virtual machines from code — and a small Kubernetes cluster sits on the same Proxmox nodes.</p>
        <p class="tags"><span class="chip">Proxmox</span><span class="chip">Terraform</span><span class="chip">Immich</span><span class="chip">Home Assistant</span><span class="chip">TrueNAS</span></p>
        <p class="actions"><a class="btn" href="/work/homelab">The homelab →</a></p>
      </article>

      <article class="step" data-target="3">
        <p class="eyebrow"><b>03</b> · Darkroom</p>
        <h2>Machines that develop and scan film.</h2>
        <p>CineRestore is the software, firmware and electronics behind a film-developing machine and film scanners — plus the website of the photo lab I’m still a member of.</p>
        <p class="pull">Analogue film is data too: a negative goes in, a traceable digital master comes out.</p>
        <p class="tags"><span class="chip">Rust</span><span class="chip">Tauri</span><span class="chip">ESP32</span><span class="chip">React</span><span class="chip">Astro</span></p>
        <p class="actions"><a class="btn" href="/work/cinerestore">CineRestore →</a><a class="btn" href="/work/labphoto">The lab’s website →</a></p>
      </article>
    </div>
  </section>

  <section class="wrap sec" id="latest">
    <p class="eyebrow"><b>Latest</b> · this site is where I share what I build, as I build it</p>
    <h2>Always something in progress.</h2>

    <figure class="act">
      <svg viewBox={`0 0 ${AW} ${AH}`} role="img" aria-label="Activity chart: one dot per project, note or photo published over the last 24 months">
        {months.map((m, i) => (
          <g>
            {m.n.map((it, j) => <circle cx={i * CW + CW / 2 + 5} cy={AH - 30 - j * RH - RH / 2} r="6.5" class:list={["a-dot", it.kind, it.live && "live"]}><title>{`${it.title} — ${kindLabel[it.kind]}`}</title></circle>)}
            <text x={i * CW + CW / 2 + 5} y={AH - 12} text-anchor="middle" class="a-lab">{m.label}</text>
            {(m.label === "Jan" || i === 0) && <text x={i * CW + 5} y={AH - 1} class="a-yr">{m.year}</text>}
          </g>
        ))}
      </svg>
      <figcaption class="mono"><span class="k project"></span>project <span class="k note"></span>note / article <span class="k photo"></span>photo — one dot per thing published</figcaption>
    </figure>

    <ul class="feed">
      {latest.map((it) => (
        <li>
          <a href={it.href}>
            <span class="f-meta mono"><span class:list={["f-kind", it.kind]}>{kindLabel[it.kind]}</span>{it.date.toLocaleDateString("en-US", { day: "numeric", month: "short", year: "numeric" })}{it.live && <span class="badge live"><i></i>in progress</span>}</span>
            <span class="f-title">{it.title}</span>
            {it.text && <span class="f-text">{it.text}</span>}
          </a>
        </li>
      ))}
    </ul>
    <p class="actions" style="display:flex;gap:.8rem;margin-top:1.6rem"><a class="btn" href="/blog">Open the journal →</a></p>
  </section>

  <section class="wrap sec proj" id="projets">
    <p class="eyebrow"><b>Projects</b> · hover a project to see its shape</p>
    <h2>Four rooms, one lab.</h2>
    <div class="proj-grid">
      <div>
        {rooms.map((room) => {
          const items = projects.filter((p) => p.data.room === room.key);
          return items.length > 0 && (
            <div class="room">
              <h3 class="room-h"><span>{room.title}</span><small>{room.blurb}</small></h3>
              <ul class="proj-list">
                {items.map((p) => (
                  <li>
                    <a href={`/work/${p.id}`} data-layout={shape[p.id]?.layout} data-note={shape[p.id]?.note}>
                      <span class="badge" class:list={[p.data.status === "in_progress" && "live"]}><i></i>{p.data.status === "in_progress" ? "In progress" : "Completed"}</span>
                      <span class="pn">{p.data.title.split(/ [—:] /)[0]}</span>
                      <span class="pi">{p.data.impact ?? p.data.summary}</span>
                      <span class="tags">{p.data.stack.slice(0, 5).map((t) => <span class="chip">{t}</span>)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
      <div class="proj-stage" aria-hidden="true">
        <canvas id="proj-canvas"></canvas>
        <p class="mono legend" id="proj-note"></p>
      </div>
    </div>
  </section>

  <section class="wrap sec">
    <p class="eyebrow"><b>What I’m looking for</b></p>
    <h2>A permanent data engineering role, <em>from 2027.</em></h2>
    <p class="lead" style="max-width:34em;margin:0 0 2.5rem">I finish my Master’s in 2027 and I’m looking for a CDI as a data engineer — the next step after my work-study year. I want to build the data foundations teams actually rely on, in any industry. My experience already spans education, banking and finance, and I’m happy to learn a new domain.</p>
    <div class="roles">
      {strengths.map((r, i) => <div><span class="mono n">0{i + 1}</span><h3>{r.t}</h3><p>{r.d}</p></div>)}
    </div>
    <p class="actions" style="display:flex;gap:.8rem;margin-top:2.5rem"><a class="btn solid" href={`mailto:${person.email}`}>Get in touch</a><a class="btn" href="/about">My background</a></p>
  </section>
</Base>

<script>
  import { createDots } from "../scripts/dots";
  const layouts = ["scatter", "clusters", "cluster", "film"] as const;

  // — Story : le scroll pilote la transformation des points
  const sc = document.getElementById("story-canvas") as HTMLCanvasElement;
  const steps = [...document.querySelectorAll<HTMLElement>(".step")];
  if (sc && steps.length) {
    const dots = createDots(sc, "scatter");
    const update = () => {
      const mid = innerHeight * 0.5;
      const c = steps.map((s) => { const r = s.getBoundingClientRect(); return r.top + r.height / 2; });
      let tt = Number(steps[0].dataset.target);
      if (mid >= c[c.length - 1]) tt = Number(steps[steps.length - 1].dataset.target);
      else for (let i = 0; i < c.length - 1; i++) {
        if (mid >= c[i] && mid < c[i + 1]) {
          const f = (mid - c[i]) / (c[i + 1] - c[i]), a = Number(steps[i].dataset.target), b = Number(steps[i + 1].dataset.target);
          tt = a + (b - a) * Math.min(1, Math.max(0, (f - 0.2) / 0.6)); break;
        }
      }
      const k = Math.min(layouts.length - 2, Math.floor(tt));
      dots.blend(layouts[k], layouts[k + 1], tt - k);
    };
    addEventListener("scroll", update, { passive: true }); addEventListener("resize", update); update();
  }

  // — Projets : chaque projet a sa forme
  const pc = document.getElementById("proj-canvas") as HTMLCanvasElement;
  const note = document.getElementById("proj-note");
  if (pc) {
    const dots = createDots(pc, "scatter");
    const links = [...document.querySelectorAll<HTMLAnchorElement>(".proj-list a")];
    const show = (a: HTMLAnchorElement) => {
      links.forEach((l) => l.classList.toggle("on", l === a));
      if (a.dataset.layout) dots.to(a.dataset.layout as any, 900);
      if (note) note.textContent = a.dataset.note ?? "";
    };
    links.forEach((a) => { a.addEventListener("mouseenter", () => show(a)); a.addEventListener("focus", () => show(a)); });
    const first = links[0]; if (first) show(first);
  }
</script>

<style is:global>
  .story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; }
  .stage { position: sticky; top: 64px; height: calc(100vh - 64px); order: 2; display: flex; flex-direction: column; justify-content: center; }
  .stage canvas { width: 100%; height: min(78vh, 640px); display: block; }
  .legend { font-size: .7rem; color: var(--dim); text-align: center; margin: .6rem 0 0; min-height: 2.4em; }
  .steps { order: 1; }
  .step { min-height: 92vh; display: flex; flex-direction: column; justify-content: center; max-width: 520px; padding: 4rem 0; }
  .step:first-child { min-height: calc(100vh - 64px); }
  .step h1 { font-size: clamp(2.8rem, 6.4vw, 5.6rem); margin: 1rem 0 1.6rem; letter-spacing: -0.035em; text-wrap: balance; }
  .step h1 em { color: var(--accent); font-style: italic; font-variation-settings: "opsz" 144, "SOFT" 100; }
  .step h2 { font-size: clamp(2rem, 4vw, 3.1rem); margin: .8rem 0 1.2rem; text-wrap: balance; }
  .step p { margin: 0 0 1.1rem; }
  .lead { font-size: 1.25rem; line-height: 1.5; max-width: 30em; }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: .8rem !important; }
  .hint { font-size: .75rem; color: var(--dim); margin-top: 3rem !important; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; }
  .pull { font-family: var(--serif); font-style: italic; font-size: 1.15rem; color: var(--dim); border-left: 3px solid var(--accent); padding-left: 1rem; }

  .proj-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 3rem; align-items: start; }
  .act { margin: 0 0 2.5rem; overflow-x: auto; }
  .act svg { width: 100%; min-width: 620px; height: auto; display: block; }
  .a-dot { fill: var(--text); } .a-dot.project { fill: var(--accent); } .a-dot.photo { fill: none; stroke: var(--text); stroke-width: 2; }
  .a-dot.live { animation: pulse 1.8s ease-in-out infinite; }
  .a-lab { font: 500 9px var(--mono); fill: var(--dim); } .a-yr { font: 600 9px var(--mono); fill: var(--text); }
  .act figcaption { font-size: .7rem; color: var(--dim); margin-top: .6rem; display: flex; align-items: center; flex-wrap: wrap; gap: .3rem .6rem; }
  .act .k { display: inline-block; width: .7rem; height: .7rem; border-radius: 50%; background: var(--text); }
  .act .k.project { background: var(--accent); } .act .k.photo { background: none; border: 2px solid var(--text); }
  .feed { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--text); }
  .feed a { display: grid; grid-template-columns: 13rem 1fr; grid-template-areas: "m t" "m x"; gap: .15rem 1.5rem; padding: 1.2rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .feed a:hover .f-title { color: var(--accent); }
  .f-meta { grid-area: m; font-size: .72rem; color: var(--dim); display: flex; flex-direction: column; gap: .3rem; align-items: flex-start; }
  .f-kind { color: var(--text); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; } .f-kind.project { color: var(--accent); }
  .f-title { grid-area: t; font-family: var(--serif); font-size: clamp(1.3rem, 2.4vw, 1.8rem); line-height: 1.15; }
  .f-text { grid-area: x; color: var(--dim); font-size: .95rem; max-width: 46em; }
  @media (max-width: 640px) { .feed a { grid-template-columns: 1fr; grid-template-areas: "m" "t" "x"; } .f-meta { flex-direction: row; align-items: center; } }
  .room { margin-bottom: 3rem; }
  .room-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem 1rem; font-family: var(--mono); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 600; margin: 0 0 .4rem; color: var(--accent); }
  .room-h small { font-family: var(--sans); text-transform: none; letter-spacing: 0; font-weight: 400; color: var(--dim); font-size: .88rem; }
  .proj-list { list-style: none; margin: 0; padding: 0; }
  .proj-list a { display: grid; gap: .55rem; padding: 1.6rem 0; border-top: 1px solid var(--line); text-decoration: none; transition: padding .25s; }
  .proj-list li:last-child a { border-bottom: 1px solid var(--line); }
  .proj-list a:hover, .proj-list a.on { padding-left: 1rem; }
  .proj-list .pn { font-family: var(--serif); font-size: clamp(1.7rem, 3.2vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em; }
  .proj-list a.on .pn, .proj-list a:hover .pn { color: var(--accent); }
  .proj-list .pi { color: var(--dim); max-width: 36em; font-size: .98rem; }
  .proj-list .badge { justify-self: start; }
  .proj-stage { position: sticky; top: 100px; }
  .proj-stage canvas { width: 100%; aspect-ratio: 1; display: block; }

  .roles { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); border-top: 1px solid var(--text); }
  .roles > div { padding: 1.6rem 1.6rem 2rem 0; border-bottom: 1px solid var(--line); }
  .roles .n { color: var(--accent); font-size: .8rem; }
  .sec > h2 em { color: var(--accent); font-style: italic; }
  .roles h3 { font-size: 1.7rem; margin: .5rem 0 .6rem; }
  .roles p { margin: 0; color: var(--dim); max-width: 26em; }

  @media (max-width: 900px) {
    .story { display: block; padding: 0; }
    .stage { top: 64px; height: 42vh; order: 0; background: var(--bg); z-index: 5; padding: .5rem 1rem 0; border-bottom: 1px solid var(--line); }
    .stage canvas { height: 34vh; }
    .stage .legend { margin: 0; font-size: .62rem; min-height: 0; }
    .steps { padding: 0 1.5rem; }
    .step { min-height: 70vh; padding: 2rem 0; }
    .step:first-child { min-height: 70vh; }
    .proj-grid { display: block; }
    .proj-stage { display: none; }
  }
</style>
