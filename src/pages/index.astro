---
import Base from "../layouts/Base.astro";
import Lineage from "../components/Lineage.astro";
import { getCollection } from "astro:content";
import { person, headline, pipeline } from "../data/profile";

const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const kindLabel = { personal: "perso", academic: "académique", internship: "stage" } as const;
---
<Base title={`${person.name} — Data & MLOps engineer`} description="Portfolio d'Aemane Mouteirou : projets data engineering et MLOps (Airflow, Kafka, MLflow, FastAPI, Docker), étudiant en M1 MIAGE à Dauphine – PSL.">
  <section class="hero">
    <div class="term" aria-hidden="true">
      <div class="term-bar"><i></i><i></i><i></i><span class="mono dim">whoami.yml — zsh</span></div>
      <pre class="mono"><span class="l" style="--i:0"><b class="p">$</b> cat whoami.yml</span>
<span class="l" style="--i:1"><u>name</u>:     {person.name}</span>
<span class="l" style="--i:2"><u>role</u>:     {person.role}</span>
<span class="l" style="--i:3"><u>school</u>:   {person.school}</span>
<span class="l" style="--i:4"><u>seeking</u>:  [{person.seeking.join(", ")}]</span>
<span class="l" style="--i:5"><u>status</u>:   <span class="ok"><span class="dot"></span>open_to_work</span></span>
<span class="l" style="--i:6"><b class="p">$</b> ./explain --short<span class="cur"></span></span></pre>
    </div>
    <h1>{headline}</h1>
    <p class="cta mono">
      <a href="/work">ls work/ →</a>
      <a href="/about">cat about.md →</a>
      <button type="button" class="linklike" onclick="document.getElementById('open-palette').click()">/ cmd</button>
    </p>
  </section>

  <section class="sec lin-sec">
    <h2>lineage — projets → technologies</h2>
    <Lineage />
  </section>

  <section class="sec">
    <h2>runs — historique des projets</h2>
    <div class="runs">
      {projects.map((p) => (
        <a class="run" href={`/work/${p.id}`}>
          <span class="mono st"><span class:list={["dot", p.data.status === "in_progress" && "live"]}></span>{p.data.status === "in_progress" ? "running" : "success"}</span>
          <span class="nm">{p.data.name ?? p.id}</span>
          <span class="sm">{p.data.summary}</span>
          <span class="meta mono dim">{kindLabel[p.data.kind]} · {fmt(p.data.publishedAt)}</span>
          <span class="stk">{p.data.stack.slice(0, 6).map((t) => <span class="chip">{t}</span>)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="sec">
    <h2>pipeline — ma stack, étape par étape</h2>
    <ol class="pipe mono">
      {pipeline.map((s) => (
        <li>
          <span class="accent">{s.stage}</span>
          <span class="dim">{s.items.map((i) => i.name).join(" · ")}</span>
        </li>
      ))}
    </ol>
    <p class="mono dim small">● en pratique · ○ en apprentissage — détail sur <a href="/about#stack">/about</a>.</p>
  </section>
</Base>

<style is:global>
  .hero { padding: 3.5rem 0 0; }
  .term { border: 1px solid var(--line); background: var(--panel); max-width: 640px; }
  .term-bar { display: flex; align-items: center; gap: .4rem; padding: .5rem .8rem; border-bottom: 1px solid var(--line); font-size: .72rem; }
  .term-bar i { width: .6rem; height: .6rem; border-radius: 50%; background: var(--line); }
  .term-bar span { margin-left: .6rem; }
  .term pre { margin: 0; padding: 1rem 1.1rem; font-size: .88rem; line-height: 1.85; min-height: 14.5em; overflow-x: auto; }
  .term u { text-decoration: none; color: var(--cyan); }
  .term .p { color: var(--accent); }
  .term .ok { color: var(--ok); }
  .term .l { opacity: 0; animation: show .01s forwards; animation-delay: calc(var(--i) * .22s + .15s); }
  .cur { display: inline-block; width: .6em; height: 1.05em; background: var(--accent); vertical-align: text-bottom; margin-left: .25em; animation: blink 1.1s steps(1) infinite; }
  @keyframes show { to { opacity: 1; } } @keyframes blink { 50% { opacity: 0; } }
  .hero h1 { font-size: clamp(1.5rem, 3.4vw, 2.3rem); max-width: 22em; margin: 2.2rem 0 1.2rem; font-weight: 600; text-wrap: balance; }
  .cta { display: flex; flex-wrap: wrap; gap: .5rem 1.6rem; font-size: .92rem; margin: 0; }
  .cta a { text-decoration: none; }
  .linklike { font: inherit; background: none; border: 0; padding: 0; color: var(--dim); cursor: pointer; }
  .linklike:hover { color: var(--accent); }

  .runs { border-top: 1px solid var(--line); }
  .run { display: grid; grid-template-columns: 7.5rem 11rem 1fr; grid-template-areas: "st nm sm" ". meta stk"; gap: .2rem 1rem; padding: 1.05rem .6rem; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .run:hover { background: var(--panel); }
  .run:hover .nm { color: var(--accent); }
  .run .st { grid-area: st; font-size: .8rem; color: var(--dim); }
  .run .nm { grid-area: nm; font-family: var(--mono); font-weight: 600; }
  .run .sm { grid-area: sm; font-size: .92rem; color: var(--dim); }
  .run .meta { grid-area: meta; font-size: .74rem; }
  .run .stk { grid-area: stk; display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .2rem; }
  @media (max-width: 720px) {
    .run { grid-template-columns: 1fr; grid-template-areas: "st" "nm" "sm" "meta" "stk"; }
  }

  @media (max-width: 720px) { .lin-sec { display: none; } }
  .term pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  .pipe { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border: 1px solid var(--line); counter-reset: s; }
  .pipe li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: .7rem 1rem; border-bottom: 1px solid var(--line); font-size: .86rem; counter-increment: s; }
  .pipe li:last-child { border-bottom: 0; }
  .pipe li::before { content: none; }
  .small { font-size: .78rem; margin-top: .8rem; }
  @media (max-width: 560px) { .pipe li { grid-template-columns: 1fr; gap: .1rem; } }
</style>
