---
import Base from "../layouts/Base.astro";
import Newsletter from "../components/Newsletter.astro";
import { mk, lp, dateLocale, type Lang } from "../i18n";
import { postsFor } from "../lib/content";

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = mk(lang);
const l = (path: string) => lp(lang, path);
const posts = (await postsFor(lang)).map((x) => x.entry);
---
<Base title={tr("Journal — notes and write-ups", "Journal — notes et articles")} description={tr("Aemane Mouteirou’s journal: notes, experiments and write-ups on data, infrastructure and analogue film.", "Le journal d'Aemane Mouteirou : notes, expériences et articles sur la donnée, l'infrastructure et la photo argentique.")}>
  <div class="wrap page">
    <p class="eyebrow"><b>Journal</b></p>
    <h1 class="big">{tr("Notes from the lab, ", "Notes du labo, ")}<em>{tr("as they happen.", "au fil de l'eau.")}</em></h1>
    <ul class="posts">
      {posts.map((p) => (
        <li><a href={l(`/blog/${p.id}`)}>
          <span class="mono dim">{p.data.publishedAt.toLocaleDateString(dateLocale(lang), { day: "numeric", month: "short", year: "numeric" })} · {p.data.type}</span>
          <h2>{p.data.title}</h2>
          <p class="dim">{p.data.summary}</p>
          <span class="tags" style="display:flex;flex-wrap:wrap;gap:.35rem">{p.data.tags.map((t) => <span class="chip">{t}</span>)}</span>
        </a></li>
      ))}
    </ul>
  </div>
  <Newsletter compact />
</Base>
<style is:global>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--text); }
  .posts a { display: grid; gap: .4rem; padding: 2rem 0; border-bottom: 1px solid var(--line); text-decoration: none; max-width: 780px; }
  .posts h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin: 0; } .posts a:hover h2 { color: var(--accent); } .posts p { margin: 0; }
</style>
