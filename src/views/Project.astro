---
import Base from "../layouts/Base.astro";
import { render, type CollectionEntry } from "astro:content";
import { mdxComponents } from "../components/mdx";
import { shapes, roomLabel } from "../data/shapes";
import { mk, lp, dateLocale, type Lang } from "../i18n";
import { postsFor } from "../lib/content";
import { projectArticles } from "../data/related";

interface Props { lang: Lang; entry: CollectionEntry<"projects">; fallback?: boolean; prev: CollectionEntry<"projects"> | null; next: CollectionEntry<"projects"> | null }
const { lang, entry, fallback = false, prev, next } = Astro.props;
const tr = mk(lang);
const l = (path: string) => lp(lang, path);
const { Content, headings } = await render(entry);
const d = entry.data;
const toc = headings.filter((h) => h.depth === 2);
const [cover, ...rest] = d.images;
const isRepo = d.link?.startsWith("http");
const kind = { personal: tr("Personal project", "Projet personnel"), academic: tr("Academic project", "Projet académique"), internship: tr("Internship", "Stage"), workstudy: tr("Work-study", "Alternance") }[d.kind];
const [name, ...sub] = d.title.split(/ [—:] /);
const subtitle = sub.join(" — ");
const fmt = (x: Date) => x.toLocaleDateString(dateLocale(lang), { month: "long", year: "numeric" });
const when = d.status === "in_progress" ? `${tr("Since", "Depuis")} ${fmt(d.publishedAt)}` : fmt(d.publishedAt);
const shape = shapes[entry.id] ?? { layout: "scatter", note: "", fr: "" };
const note = lang === "fr" ? shape.fr : shape.note;
const room = roomLabel[lang][d.room];
const relatedIds = projectArticles[entry.id] ?? [];
const related = relatedIds.length ? (await postsFor(lang)).map((x) => x.entry).filter((p) => relatedIds.includes(p.id)) : [];
---
<Base title={d.seoTitle ?? d.title} description={d.seoDescription ?? d.summary} image={cover} type="article" kind="project" published={d.publishedAt} keywords={d.stack} crumbs={[{ name: tr("Projects", "Projets"), href: l("/work") }, { name, href: l(`/work/${entry.id}`) }]}>
  <div class="progress" aria-hidden="true"><i id="bar"></i></div>

  <header class="wrap ph">
    <nav class="crumbs mono" aria-label={tr("Breadcrumb", "Fil d'Ariane")}><a href={l("/work")}>{tr("Projects", "Projets")}</a><span>/</span><a href={`${l("/work")}#${d.room}`}>{room}</a><span>/</span><span aria-current="page">{name}</span></nav>
    <div class="ph-grid">
      <div class="ph-text">
        <span class="badge" class:list={[d.status === "in_progress" && "live"]}><i></i>{d.status === "in_progress" ? tr("In progress", "En cours") : tr("Completed", "Terminé")} · {when}</span>
        <h1>{name}</h1>
        {subtitle && <p class="ph-sub">{subtitle}</p>}
        {d.impact && <p class="ph-impact">{d.impact}</p>}
        <div class="ph-actions">
          {d.link && <a class="btn solid" href={d.link} target={isRepo ? "_blank" : undefined} rel="noopener">{isRepo ? tr("View the code ↗", "Voir le code ↗") : tr("Read the report ↗", "Lire le rapport ↗")}</a>}
          {toc.length > 0 && <a class="btn" href={`#${toc[0].slug}`}>{tr("Read the story ↓", "Lire l'histoire ↓")}</a>}
        </div>
      </div>
      <figure class="ph-shape" aria-hidden="true">
        <canvas id="shape-canvas" data-layout={shape.layout}></canvas>
        {note && <figcaption class="mono">{note}</figcaption>}
      </figure>
    </div>

    <dl class="ph-facts">
      <div><dt>{tr("Room", "Pièce")}</dt><dd>{room}</dd></div>
      <div><dt>Type</dt><dd>{kind}</dd></div>
      {d.team && <div><dt>{tr("Team", "Équipe")}</dt><dd>{d.team.map((m) => m.name).join(", ")}</dd></div>}
      <div class="wide"><dt>Stack</dt><dd class="chips">{d.stack.map((t) => <span class="chip">{t}</span>)}</dd></div>
    </dl>
  </header>

  <div class="wrap body-grid">
    <aside class="side">
      {toc.length > 0 && (
        <nav class="toc" aria-label={tr("On this page", "Sur cette page")}>
          <p class="eyebrow">{tr("On this page", "Sur cette page")}</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-id={h.slug}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </aside>

    <article class="main" lang={fallback ? "en" : undefined}>
      {fallback && <p class="fb mono">{tr("", "Cette page n'est pas encore disponible en français : voici la version anglaise.")}</p>}
      {cover && <a href={cover} target="_blank" rel="noopener" style="display:inline-block;cursor:zoom-in"><img class="cover" src={cover} alt={tr(`Preview of ${d.title}`, `Aperçu de ${d.title}`)} fetchpriority="high" decoding="async" /></a>}

      {d.updates.length > 0 && (
        <section class="upd">
          <p class="eyebrow"><b>{tr("Progress log", "Journal d'avancement")}</b></p>
          <ol>{[...d.updates].sort((a, b) => +b.date - +a.date).map((u) => <li><time class="mono dim">{u.date.toLocaleDateString(dateLocale(lang), { day: "numeric", month: "short", year: "numeric" })}</time><span>{u.text}</span></li>)}</ol>
        </section>
      )}

      <div class="prose story-body"><Content components={mdxComponents} /></div>

      {related.length > 0 && (
        <section class="rel">
          <p class="eyebrow"><b>{tr("Written up in the journal", "Raconté dans le journal")}</b></p>
          <ul>{related.map((p) => <li><a href={l(`/blog/${p.id}`)}>{p.data.title}</a><span class="dim">{p.data.summary}</span></li>)}</ul>
        </section>
      )}

      {rest.length > 0 && (
        <section class="gal">
          <p class="eyebrow"><b>{tr("Gallery", "Galerie")}</b></p>
          <div class="gal-grid">{rest.map((src) => <img src={src} alt={tr(`Screenshot of ${d.title}`, `Capture de ${d.title}`)} loading="lazy" decoding="async" width="800" height="450" />)}</div>
        </section>
      )}
    </article>
  </div>

  <nav class="wrap pn" aria-label={tr("More projects", "Autres projets")}>
    {prev ? <a class="pn-a" href={l(`/work/${prev.id}`)}><span class="mono dim">{tr("← Previous project", "← Projet précédent")}</span><b>{prev.data.title.split(/ [—:] /)[0]}</b></a> : <span></span>}
    <a class="pn-all mono" href={l("/work")}>{tr("All projects", "Tous les projets")}</a>
    {next ? <a class="pn-a r" href={l(`/work/${next.id}`)}><span class="mono dim">{tr("Next project →", "Projet suivant →")}</span><b>{next.data.title.split(/ [—:] /)[0]}</b></a> : <span></span>}
  </nav>
</Base>

<script>
  import { createDots } from "../scripts/dots";
  const c = document.getElementById("shape-canvas") as HTMLCanvasElement | null;
  if (c) {
    const dots = createDots(c, "scatter");
    const layout = (c.dataset.layout ?? "scatter") as any;
    setTimeout(() => dots.to(layout, 1400), 250);
  }

  // Barre de progression + sommaire actif
  const bar = document.getElementById("bar");
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  const heads = links.map((a) => document.getElementById(a.dataset.id!)).filter(Boolean) as HTMLElement[];
  const onScroll = () => {
    const h = document.documentElement;
    if (bar) bar.style.transform = `scaleX(${Math.min(1, h.scrollTop / Math.max(1, h.scrollHeight - innerHeight))})`;
    let cur = 0; heads.forEach((el, i) => { if (el.getBoundingClientRect().top < innerHeight * 0.3) cur = i; });
    links.forEach((a, i) => a.classList.toggle("on", i === cur));
  };
  addEventListener("scroll", onScroll, { passive: true }); onScroll();
</script>

<style is:global>
  .fb { margin: 0 0 1.5rem; padding: .6rem .9rem; border: 1px dashed var(--accent); border-radius: 8px; font-size: .78rem; color: var(--dim); }
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 40; }
  .progress i { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; }

  .ph { padding-top: 2rem; }
  .crumbs { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--dim); margin-bottom: 2rem; }
  .crumbs a { color: var(--dim); text-decoration: none; } .crumbs a:hover { color: var(--accent-text); }
  .crumbs [aria-current] { color: var(--text); }
  .ph-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 3rem; align-items: center; }
  .ph-text h1 { font-size: clamp(3rem, 7vw, 5.6rem); margin: 1.2rem 0 .4rem; letter-spacing: -0.04em; line-height: .95; }
  .ph-sub { font-family: var(--serif); font-size: clamp(1.2rem, 2.2vw, 1.7rem); color: var(--dim); margin: 0 0 1.4rem; line-height: 1.2; }
  .ph-impact { font-size: 1.12rem; line-height: 1.55; max-width: 32em; margin: 0 0 1.8rem; }
  .ph-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
  .ph-shape { margin: 0; }
  .ph-shape canvas { width: 100%; aspect-ratio: 1; max-height: 440px; display: block; }
  .ph-shape figcaption { font-size: .68rem; color: var(--dim); text-align: center; margin-top: .5rem; }
  .ph-facts { display: flex; flex-wrap: wrap; gap: 1.2rem 3rem; margin: 3rem 0 0; padding: 1.1rem 0; border-top: 1px solid var(--text); border-bottom: 1px solid var(--line); }
  .ph-facts dt { font-family: var(--mono); font-size: .66rem; text-transform: uppercase; letter-spacing: .1em; color: var(--dim); }
  .ph-facts dd { margin: .25rem 0 0; font-weight: 500; font-size: .95rem; }
  .ph-facts .wide { flex: 1 1 100%; }
  .ph-facts .chips { display: flex; flex-wrap: wrap; gap: .35rem; }

  .body-grid { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 4rem; margin-top: 4rem; align-items: start; }
  .side { position: sticky; top: 90px; }
  .toc ol { list-style: none; margin: .8rem 0 0; padding: 0; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: .35rem 0 .35rem 1rem; margin-left: -1px; border-left: 2px solid transparent; font-size: .88rem; line-height: 1.35; color: var(--dim); text-decoration: none; }
  .toc a:hover { color: var(--text); }
  .toc a.on { color: var(--text); border-left-color: var(--accent); font-weight: 600; }
  .main { min-width: 0; }
  .cover { width: auto; max-width: 100%; height: auto; max-height: 300px; border-radius: 8px; margin: 0 0 2.5rem; background: var(--panel); display: block; border: 1px solid var(--line); }

  .story-body { counter-reset: sec; }
  .story-body h2 { counter-increment: sec; scroll-margin-top: 90px; font-size: clamp(1.7rem, 3vw, 2.2rem); margin: 3.6rem 0 1rem; display: flex; align-items: baseline; gap: .9rem; }
  .story-body h2::before { content: counter(sec, decimal-leading-zero); font-family: var(--mono); font-size: .75rem; color: var(--accent-text); letter-spacing: .06em; font-weight: 500; transform: translateY(-.35em); }
  .story-body h2:first-child { margin-top: 0; }

  .rel { margin-top: 4rem; max-width: 700px; } .rel ul { list-style: none; margin: .8rem 0 0; padding: 0; } .rel li { display: grid; gap: .15rem; padding: .9rem 0; border-top: 1px solid var(--line); } .rel a { font-family: var(--serif); font-size: 1.25rem; line-height: 1.2; } .rel .dim { font-size: .88rem; }
  .upd { margin: 0 0 3rem; max-width: 700px; }
  .upd ol { list-style: none; margin: .8rem 0 0; padding: 0; border-left: 2px solid var(--accent); }
  .upd li { display: grid; grid-template-columns: 8.5rem 1fr; gap: 1rem; padding: .5rem 0 .5rem 1rem; }
  .upd time { font-size: .76rem; padding-top: .2rem; }

  .gal { margin-top: 4rem; }
  .gal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 220px)); gap: .8rem; margin-top: 1rem; }
  .gal-grid img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); }

  .pn { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.5rem; align-items: center; margin-top: 6rem; padding: 1.6rem 0 0; border-top: 1px solid var(--text); }
  .pn-a { display: grid; gap: .2rem; text-decoration: none; }
  .pn-a b { font-family: var(--serif); font-weight: 500; font-size: 1.6rem; letter-spacing: -0.02em; line-height: 1.05; }
  .pn-a:hover b { color: var(--accent-display); }
  .pn-a.r { text-align: right; }
  .pn-all { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; text-decoration: none; color: var(--dim); }

  @media (max-width: 960px) {
    .ph-grid { grid-template-columns: 1fr; gap: 2rem; }
    .ph-shape { order: -1; max-width: 360px; }
    .body-grid { display: block; margin-top: 2.5rem; }
    .side { position: static; margin-bottom: 2rem; }
    .toc { border: 1px solid var(--line); border-radius: 8px; padding: 1rem 1.2rem; }
    .pn { grid-template-columns: 1fr 1fr; }
    .pn-all { grid-column: 1 / -1; order: 3; text-align: center; padding-top: .6rem; }
  }
  @media (max-width: 560px) { .upd li { grid-template-columns: 1fr; gap: .1rem; } }
</style>
