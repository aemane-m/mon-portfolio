---
import Base from "../layouts/Base.astro";
import log from "../data/changelog.json";
import { mk, dateLocale, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = mk(lang);
const fmtMonth = (d: string) => new Date(d + "T12:00:00").toLocaleDateString(dateLocale(lang), { month: "long", year: "numeric" });
const fmtDay = (d: string) => new Date(d + "T12:00:00").toLocaleDateString(dateLocale(lang), { day: "numeric", month: "short" });
const groups: { label: string; items: typeof log }[] = [];
for (const c of log) { const label = fmtMonth(c.date); const g = groups[groups.length - 1]; if (g && g.label === label) g.items.push(c); else groups.push({ label, items: [c] }); }
const kinds: Record<string, [string, string]> = { feat: ["Feature", "Nouveauté"], fix: ["Fix", "Correction"], content: ["Content", "Contenu"], perf: ["Speed", "Vitesse"], chore: ["Upkeep", "Entretien"], dev: ["Dev", "Dev"], other: ["Other", "Autre"] };
const label = (t: string) => (kinds[t] ?? kinds.other)[lang === "fr" ? 1 : 0];
---
<Base title={tr("Changelog — Aemane Mouteirou", "Historique des modifications — Aemane Mouteirou")} description={tr("The commit history of this website: what changed, and when.", "L'historique des commits de ce site : ce qui a changé, et quand.")}>
  <div class="wrap page">
    <p class="eyebrow"><b>{tr("Changelog", "Historique")}</b> · {log.length} {tr("changes", "modifications")}</p>
    <h1 class="big">{tr("How this site ", "Comment ce site ")}<em>{tr("was built.", "a été construit.")}</em></h1>
    <p class="lead dim" style="max-width:38em">{tr("Every change to this website is a commit in a git repository. This is the list, newest first — written for developers, so the messages stay in English.", "Chaque modification de ce site est un commit dans un dépôt git. Voici la liste, du plus récent au plus ancien. Les messages sont écrits pour des développeurs : ils restent en anglais.")}</p>
    <p class="actions" style="margin:1rem 0 2.5rem"><a class="btn" href="https://github.com/aemane-m/mon-portfolio/commits" target="_blank" rel="noopener">{tr("See it on GitHub ↗", "Voir sur GitHub ↗")}</a></p>

    {groups.map((g) => (
      <section class="cl-month">
        <h2 class="mono">{g.label}</h2>
        <ul class="cl">
          {g.items.map((c) => (
            <li>
              <span class="cl-date mono">{fmtDay(c.date)}</span>
              <span class={`cl-kind mono k-${c.type}`}>{label(c.type)}</span>
              <span class="cl-msg">{c.scope && <b>{c.scope}</b>}{c.scope && " — "}{c.subject}</span>
              <code class="cl-hash">{c.hash}</code>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style is:global>
  .cl-month { margin-top: 2.4rem; }
  .cl-month h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; color: var(--accent-text); border-bottom: 1px solid var(--text); padding-bottom: .5rem; margin: 0; }
  .cl { list-style: none; margin: 0; padding: 0; }
  .cl li { display: grid; grid-template-columns: 4.5rem 6rem minmax(0, 1fr) auto; gap: .2rem 1rem; align-items: baseline; padding: .75rem 0; border-bottom: 1px solid var(--line); }
  .cl-date { font-size: .72rem; color: var(--dim); }
  .cl-kind { font-size: .66rem; text-transform: uppercase; letter-spacing: .08em; color: var(--dim); }
  .cl-kind.k-feat, .cl-kind.k-perf { color: var(--accent-text); font-weight: 600; }
  .cl-msg { overflow-wrap: anywhere; }
  .cl-msg b { font-weight: 600; }
  .cl-hash { font-family: var(--mono); font-size: .72rem; color: var(--dim); background: none; padding: 0; }
  @media (max-width: 640px) {
    .cl li { grid-template-columns: 1fr auto; }
    .cl-msg { grid-column: 1 / -1; grid-row: 2; }
    .cl-hash { grid-column: 2; grid-row: 1; }
  }
</style>
