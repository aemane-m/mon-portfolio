# This file is a placeholder for environment variables required to run this project.
# Currently, there are no environment variables needed.

# Example of what future variables might look like:
# NEXT_PUBLIC_API_KEY=your_api_key_here
# DATABASE_URL=your_database_url_here
# SECRET_KEY=your_secret_key_here
# .env.example
# Variables d'environnement de l'app (exemple)
# Copiez ce fichier en `.env.local` et remplissez les valeurs.

# URL publique du site (utile pour OG tags, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL=https://dpmaine.fr

# Analytics (désactive si non utilisé)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Mot de passe pour protéger certaines pages (optionnel)
# Activer seulement si la protection est utilisée dans le code.
# PAGE_ACCESS_PASSWORD=change-me

# Exemple d'API publique (si jamais tu en ajoutes une)
# NEXT_PUBLIC_API_BASE=https://api.example.com

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=RandomSecurePassword123!
